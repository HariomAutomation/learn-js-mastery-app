{
  "id": "02-data-types-01-primitive-types-39",
  "title": "Default parameters",
  "starterCode": "function greet(name = \"Guest\", time = \"Day\") {\n  // TODO\n}\n",
  "solution": "function greet(name = \"Guest\", time = \"Day\") {\n  return `Good ${time}, ${name}!`\n}",
  "tests": [
    {
      "input": [
        "Hariom",
        "Morning"
      ],
      "expected": "Good Morning, Hariom!"
    },
    {
      "input": [],
      "expected": "Good Day, Guest!"
    }
  ],
  "hints": [
    "Parameter = defaultValue se default set hota hai",
    "Agar argument na mile to default use hota hai"
  ]
}