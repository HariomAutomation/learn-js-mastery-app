{
  "id": "02-data-types-01-primitive-types-23",
  "title": "String reverse without methods",
  "starterCode": "function reverseString(str) {\n  // TODO: use split, reverse, join\n}\n",
  "solution": "function reverseString(str) {\n  return str.split(\"\").reverse().join(\"\")\n}",
  "tests": [
    {
      "input": [
        "hello"
      ],
      "expected": "olleh"
    },
    {
      "input": [
        "JavaScript"
      ],
      "expected": "tpircSavaJ"
    }
  ],
  "hints": [
    "split('') se array banta hai",
    "reverse() array reverse karta hai",
    "join('') se string banti hai"
  ]
}