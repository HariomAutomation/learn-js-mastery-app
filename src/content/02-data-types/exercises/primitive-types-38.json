  "title": "Rest parameters",
  "starterCode": "function sum(...numbers) {\n  // TODO\n}\n",
  "solution": "function sum(...numbers) {\n  return numbers.reduce((acc, n) => acc + n, 0)\n}",
  "tests": [
    {
      "input": [
        1,
        2,
        3
      ],
      "expected": 6
    },
