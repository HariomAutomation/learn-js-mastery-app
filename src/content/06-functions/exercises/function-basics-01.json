          4
        ],
        "expected": [
          false
        ]
      },
      {
        "input": [
          2
        ],
        "expected": [
          true
        ]
      }
    ],
    "hints": [
      "2 se kam prime nahi hota",
      "sqrt tak check karo"
    ]
  },
