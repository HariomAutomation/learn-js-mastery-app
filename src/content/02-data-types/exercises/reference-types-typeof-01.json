{
  "id": "02-data-types-02-reference-types-typeof-01",
  "title": "Array type check",
  "starterCode": "function isArray(val) {\n  // TODO\n}\n",
  "solution": "function isArray(val) {\n  return Array.isArray(val)\n}",
  "tests": [
    {
      "input": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": true
    },
    {
      "input": [
        "hello"
      ],
      "expected": false
    },
    {
      "input": [
        {}
      ],
      "expected": false
    }
  ],
  "hints": [
    "Array.isArray() sabse reliable hai",
    "typeof [] 'object' return karta hai"
  ]
}