{
  "id": "04-control-flow-01-if-else-switch-03",
  "title": "Even ya odd number batao",
  "starterCode": "// function evenOdd(num) mein number do\n// \"even\" ya \"odd\" return karo\n",
  "solution": "function evenOdd(num) {\n  if (num % 2 === 0) return \"even\"\n  else return \"odd\"\n}",
  "tests": [
    {
      "input": [
        4
      ],
      "expected": "even"
    },
    {
      "input": [
        7
      ],
      "expected": "odd"
    },
    {
      "input": [
        0
      ],
      "expected": "even"
    },
    {
      "input": [
        -2
      ],
      "expected": "even"
    }
  ],
  "hints": [
    "% (modulo) operator se remainder milta hai",
    "0 remainder means even hai"
  ]
}