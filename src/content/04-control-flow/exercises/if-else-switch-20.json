{
  "id": "04-control-flow-01-if-else-switch-20",
  "title": "Age group categorize karo",
  "starterCode": "// function ageGroup(age) mein number do\n// 0-1: \"Infant\", 2-5: \"Toddler\", 6-12: \"Child\", 13-17: \"Teen\", 18-64: \"Adult\", 65+: \"Senior\"\n",
  "solution": "function ageGroup(age) {\n  if (age <= 1) return \"Infant\"\n  else if (age <= 5) return \"Toddler\"\n  else if (age <= 12) return \"Child\"\n  else if (age <= 17) return \"Teen\"\n  else if (age <= 64) return \"Adult\"\n  else return \"Senior\"\n}",
  "tests": [
    {
      "input": [
        0
      ],
      "expected": "Infant"
    },
    {
      "input": [
        3
      ],
      "expected": "Toddler"
    },
    {
      "input": [
        10
      ],
      "expected": "Child"
    },
    {
      "input": [
        15
      ],
      "expected": "Teen"
    },
    {
      "input": [
        30
      ],
      "expected": "Adult"
    },
    {
      "input": [
        70
      ],
      "expected": "Senior"
    }
  ],
  "hints": [
    "Age <= se check karo ranges",
    "Order ascending mein rakho"
  ]
}